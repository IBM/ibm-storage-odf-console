{
  "name": "ibm-storage-odf-plugin",
  "version": "1.8.0",
  "description": "IBM Storage Plugin Openshift ODF",
  "author": "IBM Support <support@ibm.com>",
  "private": true,
  "repository": "git@github.com:IBM/ibm-storage-odf-console.git",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "yarn clean && NODE_ENV=production yarn ts-node ./node_modules/.bin/webpack && yarn locales",
    "build-dev": "yarn clean && yarn ts-node ./node_modules/.bin/webpack",
    "eslint": "eslint --ext .js,.jsx,.ts,.tsx,.json,.gql,.graphql --color",
    "lint": "./hack/check-copyright.sh && NODE_OPTIONS=--max-old-space-size=4096 yarn eslint .",
    "http-server": "./http-server.sh ./dist",
    "locales": "yarn i18n && cp -r locales dist/",
    "i18n": "i18next \"src/**/*.{js,ts,tsx}\" [-oc] -c i18next-parser.config.js",
    "ts-node": "ts-node -O '{\"module\":\"commonjs\"}' -I '/node_modules/(?!(@openshift-console)/)/'"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.10",
    "@patternfly/patternfly": "^5.4.2",
    "@patternfly/react-charts": "^7.4.8",
    "@patternfly/react-core": "5.4.8",
    "@patternfly/react-table": "^5.4.16",
    "classnames": "^2.3.1",
    "i18next": "^19.8.3",
    "js-base64": "^3.7.8",
    "lodash-es": "^4.17.21",
    "murmurhash-js": "1.0.x",
    "pluralize": "^8.0.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-helmet": "^6.1.0",
    "react-i18next": "^11.8.11",
    "react-router": "5.3.4",
    "react-router-dom": "5.3.4",
    "react-router-dom-v5-compat": "6.11.2"
  },
  "peerDependencies": {
    "react": "^17.0.0",
    "react-dom": "^17.0.0"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "1.8.0",
    "@openshift-console/dynamic-plugin-sdk-internal": "1.0.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "1.3.0",
    "@openshift-console/plugin-shared": "^0.0.1",
    "@types/lodash-es": "^4.17.4",
    "@types/node": "^16.7.13",
    "@types/react": "17.0.90",
    "@types/react-dom": "17.0.26",
    "@types/react-helmet": "^6.1.1",
    "@types/react-router": "5.1.20",
    "@types/react-router-dom": "5.3.3",
    "@types/webpack-dev-server": "^3.11.5",
    "@typescript-eslint/eslint-plugin": "^6",
    "@typescript-eslint/parser": "^6",
    "comment-json": "4.x",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^8",
    "eslint-plugin-react": "^7.24.0",
    "file-loader": "^6",
    "http-server": "0.12.x",
    "husky": "^4.2.5",
    "i18next-parser": "^3.3.0",
    "i18next-pseudo": "^2.2.0",
    "read-pkg": "5.x",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.97.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^0.23.1",
    "thread-loader": "^3",
    "ts-loader": "6.2.2",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn lint"
    }
  },
  "consolePlugin": {
    "name": "ibm-storage-odf-plugin",
    "version": "1.8.0",
    "displayName": "IBM Storage Plugin",
    "description": "IBM Storage Plugin for Openshift ODF",
    "dependencies": {
      "@console/pluginAPI": "*"
    },
    "exposedModules": {
      "IBMStorageODFDetailPage": "./src/flashsystem-dashboard"
    }
  },
  "resolutions": {
    "d3-color": "3.1.0",
    "@babel/runtime": "7.26.10",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "@types/react": "17.0.90",
    "@types/react-dom": "17.0.26",
    "@types/react-router": "5.1.20",
    "@types/react-router-dom": "5.3.3"
  }
}
